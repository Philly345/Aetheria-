{
  "manifest_version": 3,
  "name": "Aetheria",
  "version": "1.0",
  "description": "Privacy-first Aetheria Extension",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aetheria-azure.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Aetheria",
    "default_popup": "panel.html",
    "default_popup_size": {
      "width": 400,
      "height": 600
    }
  }
}
