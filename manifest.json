{
  "manifest_version": 3,
  "name": "Aetheria",
  "version": "1.0",
  "description": "Advanced, ultra-minimalist Aetheria Extension",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Aetheria",
    "default_popup": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.js",
        "lib/pdf.worker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
