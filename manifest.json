{
  "manifest_version": 3,
  "name": "Aetheria",
  "version": "1.0",
  "description": "Advanced, ultra-minimalist Aetheria Extension",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://aetheria-azure.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Aetheria",
    "default_popup": "panel.html"
  }
}
